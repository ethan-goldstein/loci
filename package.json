{
  "name": "loci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOCI: a profiler for how you work with AI. A local-first memory engine over your own AI coding history, with from-scratch HNSW and BM25, an MCP server, and oracles that try to prove it wrong.",
  "license": "MIT",
  "author": "Ethan Goldstein",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "loci": "src/cli.ts"
  },
  "scripts": {
    "loci": "node src/cli.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "node src/cli.ts serve",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src web tests scripts",
    "assets": "node scripts/copy-assets.ts",
    "guard": "node scripts/guard-tracked.ts",
    "build:pages": "node scripts/build-pages.ts && tsc --noEmit && vite build --mode pages",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@modelcontextprotocol/server": "^2.4.0",
    "three": "^0.186.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
