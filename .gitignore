# Drafts built from your own conversation text (for example a draft CLAUDE.md). Private.
drafts/

# Third-party runtime assets are copied in by `npm run assets`, not committed.
web/public/mediapipe/
web/public/models/

# Data for the public demo: invented text, generated by `npm run build:pages`.
web/public-pages/demo/
