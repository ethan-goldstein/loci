# All optional. LOCI runs with these defaults when nothing is set.

# Where the private store lives. Must be outside any git repository.
LOCI_HOME=~/.loci

# Where Claude Code keeps its session transcripts.
LOCI_SOURCE=~/.claude/projects

# Optional: a ChatGPT data export to ingest alongside Claude Code (the zip, its unzipped folder,
# or conversations.json). Request one in ChatGPT under Settings > Data controls > Export data.
# LOCI_CHATGPT_EXPORT=~/Downloads/chatgpt-export.zip

# Local Ollama endpoint and embedding model. Nothing is sent anywhere else.
LOCI_OLLAMA_URL=http://127.0.0.1:11434
LOCI_EMBED_MODEL=nomic-embed-text

# Port for the local viewer. The server only ever binds 127.0.0.1.
LOCI_PORT=4319
